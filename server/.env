# Committed defaults for local development. Real values belong in .env.local, which
# is gitignored. In production the deploy writes .env.local from the DEV_DOT_ENV
# Actions secret, so that secret should hold a whole .env.local file, e.g.:
#
#   APP_ENV=prod
#   APP_SECRET=<long random string: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'>
#   DATABASE_URL="mysql://<user>:<password>@<host>:3306/<db>?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
#   DEFAULT_URI=https://<your-domain>
#   MAILER_DSN=smtp://<user>:<password>@<smtp-host>:587
#   MAILER_FROM="<Site name> <noreply@your-domain>"
#   CONTACT_INBOX=<address that gets contact form notifications>
#   TRUSTED_PROXIES=PRIVATE_SUBNETS   # only if a reverse proxy in front of the container sets X-Forwarded-For
#
# APP_SECRET is also the key material for admin access tokens, so changing it logs everyone out.

APP_ENV=dev
APP_SECRET=

###> symfony/routing ###
# Base URI for URLs generated outside an HTTP request (CLI commands).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
# null://null drops every email, so local dev and tests send nothing.
MAILER_DSN=null://null
###< symfony/mailer ###

# Sender of all outgoing email, and where contact form notifications go.
MAILER_FROM=noreply@localhost
CONTACT_INBOX=contact@localhost

# Proxies whose X-Forwarded-For is trusted, so rate limits see the real client IP.
TRUSTED_PROXIES=127.0.0.1
