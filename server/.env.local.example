# Example server/.env.local. Copy to .env.local and fill in real values; never commit them.
# In production the deploy workflow writes this file from GitHub Actions secrets
# (APP_SECRET, DATABASE_URL) and the DEFAULT_URI variable, so nothing here is used there.

APP_ENV=prod

# Long random string, e.g. `php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'`.
# Also the key material for admin access tokens, so changing it logs everyone out.
APP_SECRET=change-me

DATABASE_URL='mysql://app_user:change-me@db-host:3306/app?serverVersion=11.4.0-MariaDB&charset=utf8mb4'

# Base URI for URLs generated outside an HTTP request (CLI commands).
DEFAULT_URI=https://example.com
